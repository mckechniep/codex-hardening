{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __HOME__/.codex/hooks/block_destructive.py",
            "statusMessage": "Checking destructive command policy",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 __HOME__/.codex/hooks/block_network_egress.py",
            "statusMessage": "Checking network egress policy",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
